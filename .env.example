# Copy to .env and fill in. Never commit real values.

# Postgres connection string (Neon, Supabase, local Postgres…)
DATABASE_URL="postgresql://user:password@localhost:5432/env_garden"

# Public URL of the app (used for links in emails and CLI authorization)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
# 32+ random bytes: openssl rand -base64 48
BETTER_AUTH_SECRET=""

# Encrypts every project key. 64 hex characters: openssl rand -hex 32
# Keep it safe: losing it makes stored variables unreadable.
MASTER_ENCRYPTION_KEY=""

# OAuth apps. Callback URLs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (Resend). Outside production, magic links are printed to the console instead.
RESEND_API_KEY=""
EMAIL_DOMAIN="example.com"

# Optional: raises GitHub API limits for the landing page star count
GITHUB_TOKEN=""
