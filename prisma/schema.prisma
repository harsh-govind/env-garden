generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectAccessScope {
  ALL_PROJECTS
  SELECTED_PROJECTS
}

enum EnvironmentAccessScope {
  ALL_ENVIRONMENTS
  SELECTED_ENVIRONMENTS
}

enum ProjectRole {
  OWNER
  CONTRIBUTOR
  VIEWER
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  emailVerified            Boolean                   @default(false)
  image                    String?
  avatar                   String                    @default("sprout")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  twoFactorEnabled         Boolean?                  @default(false)
  twoFactors               TwoFactor[]
  cliTokens                CliToken[]
  approvedCliLoginRequests CliLoginRequest[]         @relation("CliLoginRequestApprover")
  createdWorkspaces        Workspace[]               @relation("WorkspaceCreator")
  createdProjects          Project[]                 @relation("ProjectCreator")
  createdEnvFiles          EnvFile[]                 @relation("EnvFileCreator")
  workspaceMemberships     WorkspaceMember[]         @relation("WorkspaceMemberUser")
  workspaceMembers         WorkspaceMember[]         @relation("WorkspaceMemberAdder")
  projectMembers           ProjectMember[]           @relation("ProjectMemberAdder")
  envAccesses              ProjectEnvAccess[]        @relation("ProjectEnvAccessGrantor")
  workspaceInvitesSent     WorkspaceInvite[]         @relation("WorkspaceInviteSender")
  workspaceInvitesAccepted WorkspaceInvite[]         @relation("WorkspaceInviteAccepter")
  workspaceInvitesRevoked  WorkspaceInvite[]         @relation("WorkspaceInviteRevoker")
  keyring                  UserKeyring?
  environmentKeysCreated   EnvironmentKey[]          @relation("EnvironmentKeyCreator")
  environmentKeyShares     EnvironmentKeyShare[]     @relation("EnvironmentKeyShareRecipient")
  environmentKeyGrants     EnvironmentKeyShare[]     @relation("EnvironmentKeyShareGranter")
  isServiceAccount         Boolean                   @default(false)
  serviceAccount           ServiceAccount?           @relation("ServiceAccountUser")
  serviceAccountsCreated   ServiceAccount[]          @relation("ServiceAccountCreator")
  serviceAccountKeyHolds   ServiceAccountKeyHolder[]
}

model ServiceAccount {
  id          String                    @id @default(cuid())
  userId      String                    @unique
  workspaceId String
  name        String
  createdById String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  user        User                      @relation("ServiceAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?                     @relation("ServiceAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  keyHolders  ServiceAccountKeyHolder[]

  @@index([workspaceId])
  @@index([createdById])
}

model ServiceAccountKeyHolder {
  id               String         @id @default(cuid())
  serviceAccountId String
  userId           String
  sealedSeed       String
  createdAt        DateTime       @default(now())
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceAccountId, userId])
  @@index([userId])
}

model UserKeyring {
  id               String   @id @default(cuid())
  userId           String   @unique
  signPublicKey    String
  boxPublicKey     String   @unique
  encryptedSeed    String?
  kdfSalt          String?
  kdfAlgorithm     String?
  kdfOpsLimit      Int?
  kdfMemLimitBytes Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CliToken {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  tokenPrefix          String
  tokenHash            String    @unique
  encryptedServerShare String
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model CliLoginRequest {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  tokenPrefix        String
  tokenName          String
  pollSecretHash     String    @unique
  transportPublicKey String
  sealedPackage      String?
  expiresAt          DateTime
  approvedAt         DateTime?
  approvedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  approvedBy         User?     @relation("CliLoginRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([approvedById])
}

model Workspace {
  id              String             @id @default(cuid())
  name            String
  description     String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdBy       User               @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  projects        Project[]
  members         WorkspaceMember[]
  invites         WorkspaceInvite[]
  history         WorkspaceHistory[]
  serviceAccounts ServiceAccount[]

  @@index([createdById])
}

model Project {
  id              String                   @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members         ProjectMember[]
  envFiles        EnvFile[]
  envAccesses     ProjectEnvAccess[]
  inviteAccesses  WorkspaceInviteProject[]
  environmentKeys EnvironmentKey[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([createdById])
}

model WorkspaceMember {
  id                            String                 @id @default(cuid())
  workspaceId                   String
  userId                        String
  role                          WorkspaceRole          @default(MEMBER)
  projectAccessScope            ProjectAccessScope     @default(SELECTED_PROJECTS)
  defaultProjectRole            ProjectRole            @default(VIEWER)
  defaultEnvironmentAccessScope EnvironmentAccessScope @default(ALL_ENVIRONMENTS)
  addedById                     String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  workspace                     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                          User                   @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy                       User?                  @relation("WorkspaceMemberAdder", fields: [addedById], references: [id], onDelete: SetNull)
  projectMembers                ProjectMember[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@index([addedById])
}

model ProjectMember {
  id                     String                 @id @default(cuid())
  workspaceId            String
  projectId              String
  workspaceMemberId      String
  role                   ProjectRole            @default(CONTRIBUTOR)
  environmentAccessScope EnvironmentAccessScope @default(SELECTED_ENVIRONMENTS)
  addedById              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  project                Project                @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspaceMember        WorkspaceMember        @relation(fields: [workspaceMemberId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  addedBy                User?                  @relation("ProjectMemberAdder", fields: [addedById], references: [id], onDelete: SetNull)
  envAccesses            ProjectEnvAccess[]

  @@unique([projectId, workspaceMemberId])
  @@unique([id, projectId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([workspaceMemberId])
  @@index([addedById])
}

model WorkspaceInvite {
  id                            String                   @id @default(cuid())
  workspaceId                   String
  email                         String
  role                          WorkspaceRole            @default(MEMBER)
  projectAccessScope            ProjectAccessScope       @default(SELECTED_PROJECTS)
  defaultProjectRole            ProjectRole              @default(VIEWER)
  defaultEnvironmentAccessScope EnvironmentAccessScope   @default(ALL_ENVIRONMENTS)
  status                        WorkspaceInviteStatus    @default(PENDING)
  tokenHash                     String                   @unique
  invitedById                   String?
  acceptedById                  String?
  revokedById                   String?
  emailSentAt                   DateTime?
  expiresAt                     DateTime
  acceptedAt                    DateTime?
  revokedAt                     DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  workspace                     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy                     User?                    @relation("WorkspaceInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy                    User?                    @relation("WorkspaceInviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedBy                     User?                    @relation("WorkspaceInviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  projectAccesses               WorkspaceInviteProject[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, status])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([revokedById])
}

model WorkspaceInviteProject {
  id                     String                       @id @default(cuid())
  workspaceInviteId      String
  workspaceId            String
  projectId              String
  role                   ProjectRole                  @default(VIEWER)
  environmentAccessScope EnvironmentAccessScope       @default(SELECTED_ENVIRONMENTS)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  workspaceInvite        WorkspaceInvite              @relation(fields: [workspaceInviteId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  project                Project                      @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  environments           WorkspaceInviteEnvironment[]

  @@unique([workspaceInviteId, projectId])
  @@index([workspaceInviteId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([projectId, workspaceId])
}

model WorkspaceInviteEnvironment {
  id                       String                 @id @default(cuid())
  workspaceInviteProjectId String
  environment              String
  createdAt                DateTime               @default(now())
  workspaceInviteProject   WorkspaceInviteProject @relation(fields: [workspaceInviteProjectId], references: [id], onDelete: Cascade)

  @@unique([workspaceInviteProjectId, environment])
  @@index([workspaceInviteProjectId])
}

model EnvFile {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  environment String
  description String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy   User          @relation("EnvFileCreator", fields: [createdById], references: [id], onDelete: Restrict)
  variables   EnvVariable[]

  @@unique([projectId, name])
  @@index([workspaceId])
  @@index([projectId])
  @@index([projectId, environment])
  @@index([createdById])
}

model EnvVariable {
  id             String   @id @default(cuid())
  envFileId      String
  keyDigest      String
  encryptedKey   String
  encryptedValue String
  encryptedNote  String?
  keyVersion     Int
  isCommented    Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  envFile        EnvFile  @relation(fields: [envFileId], references: [id], onDelete: Cascade)

  @@unique([envFileId, keyDigest])
  @@index([envFileId])
  @@index([envFileId, position])
}

model EnvironmentKey {
  id               String                @id
  workspaceId      String
  projectId        String
  environment      String
  version          Int                   @default(1)
  rotationRequired Boolean               @default(false)
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  project          Project               @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  createdBy        User?                 @relation("EnvironmentKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  shares           EnvironmentKeyShare[]

  @@unique([projectId, environment])
  @@index([workspaceId])
  @@index([createdById])
}

model EnvironmentKeyShare {
  id                    String         @id @default(cuid())
  environmentKeyId      String
  userId                String
  version               Int
  recipientBoxPublicKey String
  sealedSecret          String
  signature             String
  grantedById           String?
  granterSignPublicKey  String
  createdAt             DateTime       @default(now())
  environmentKey        EnvironmentKey @relation(fields: [environmentKeyId], references: [id], onDelete: Cascade)
  user                  User           @relation("EnvironmentKeyShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy             User?          @relation("EnvironmentKeyShareGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([environmentKeyId, userId])
  @@index([userId])
  @@index([grantedById])
}

model ProjectEnvAccess {
  id              String        @id @default(cuid())
  workspaceId     String
  projectId       String
  projectMemberId String
  environment     String
  grantedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  projectMember   ProjectMember @relation(fields: [projectMemberId, projectId], references: [id, projectId], onDelete: Cascade)
  grantedBy       User?         @relation("ProjectEnvAccessGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([projectMemberId, environment])
  @@index([workspaceId])
  @@index([projectId])
  @@index([projectId, environment])
  @@index([projectMemberId])
  @@index([grantedById])
}

model WorkspaceHistory {
  id          String    @id @default(cuid())
  operation   String
  message     String    @default("")
  data        Json
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model ApiRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
